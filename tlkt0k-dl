/*
Name: TikTok HD Downloader
Type: Scraper / Downloader
Base Url: https://tikwm.com
Scrape by : Lynx decode
Note : jangan hapus credit, lynx masih pemula
*/

const axios = require('axios');
const fs = require('fs');
const readline = require('readline');

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

async function scrapeTikTok(tiktokUrl) {
    console.log('\n[*] scraping data bentar...');
    
    const apiUrl = 'https://www.tikwm.com/api/';
    
    try {
        console.log('[*] request ke api...');
        
        const response = await axios.post(apiUrl, {
            url: tiktokUrl,
            hd: 1
        }, {
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        });

        const resData = response.data;

        if (resData.code === 0) {
            const data = resData.data;
            const authorName = data.author.nickname;
            
            console.log('\n--- RESULT ---');
            console.log(`[+] author  : ${authorName}`);
            console.log(`[+] caption : ${data.title}`);
            
            let videoUrl = data.hdplay;
            if (!videoUrl) {
                console.log('[-] versi hd ga nemu, fallback ke standar aja bjir');
                videoUrl = data.play;
            } else {
                console.log('[+] link hd nemu, gas donlod');
            }

            if (videoUrl) {
                const safeAuthor = authorName.replace(/[^a-zA-Z0-9]/g, '');
                
                const randomId = Math.floor(Math.random() * 1000);
                const filePath = `/data/data/com.termux/files/home/storage/downloads/TT_${safeAuthor}_${randomId}.mp4`;
                
                console.log('[*] proses download, wait yak...');
                
                const vidRes = await axios({
                    method: 'GET',
                    url: videoUrl,
                    responseType: 'stream'
                });

                const writer = fs.createWriteStream(filePath);
                vidRes.data.pipe(writer);

                writer.on('finish', () => {
                    console.log('\n[√] DONE CUY!');
                    console.log(`[+] file kesimpen di: ${filePath}`);
                    rl.close();
                });

                writer.on('error', (err) => {
                    console.log('\n[X] error pas nulis file:', err.message);
                    rl.close();
                });

            } else {
                console.log('[-] parah link videonya kaga dapet wkwk');
                rl.close();
            }
        } else {
            console.log('[-] error dari sananya cuy:', resData.msg);
            rl.close();
        }
    } catch (error) {
        console.log('\n[X] waduh error:', error.message);
        rl.close();
    }
}

rl.question('masukin link tiktoknya: ', (link) => {
    if (!link || link.trim() === '') {
        console.log('kosong bjir, isi linknya');
        rl.close();
        return;
    }
    scrapeTikTok(link.trim());
});