const axios = require('axios');
const readline = require('readline');

const userAgents = [
    'Mozilla/5.0 (Android 14; Mobile; rv:153.0) Gecko/153.0 Firefox/153.0',
    'Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/112.0.0.0 Mobile Safari/537.36',
    'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36',
    'Mozilla/5.0 (iPhone; CPU iPhone OS 16_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.5 Mobile/15E148 Safari/604.1'
];

async function scrapeTikTok(tiktokUrl) {
    try {
        const randomUA = userAgents[Math.floor(Math.random() * userAgents.length)];

        const response = await axios.post('https://myapi.app/api/analyze', 
            `url=${encodeURIComponent(tiktokUrl)}&sitename=tikmate.cc`, 
            {
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'Accept': '*/*',
                    'Origin': 'https://tikmate.cc',
                    'Referer': 'https://tikmate.cc/',
                    'User-Agent': randomUA
                },
                timeout: 15000
            }
        );

        const data = response.data;
        
        if (!data || !data.medias) {
            throw new Error('No data received');
        }

        let hdVideo, sdVideo, audio;
        
        data.medias.forEach(media => {
            if (media.quality === 'hd_no_watermark') hdVideo = media.url;
            if (media.quality === 'no_watermark') sdVideo = media.url;
            if (media.type === 'audio') audio = media.url;
        });

        return {
            status: 'success',
            author: data.author,
            title: data.title,
            thumbnail: data.thumbnail,
            downloads: {
                hd: hdVideo || sdVideo,
                sd: sdVideo,
                audio: audio
            }
        };

    } catch (err) {
        return { 
            status: 'failed', 
            error: err.response ? `Server Error: ${err.response.status}` : err.message 
        };
    }
}

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
rl.question('Masukkan link TikTok: ', async (link) => {
    const res = await scrapeTikTok(link);
    console.log('\n======================================');
    console.log(JSON.stringify(res, null, 2));
    console.log('======================================\n');
    rl.close();
});